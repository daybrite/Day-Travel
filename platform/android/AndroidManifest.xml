<?xml version="1.0" encoding="utf-8"?>
<!--
    Android-only additions Day merges into its generated manifest; delete the file to use the
    defaults. https://daybrite.dev/docs/platforms/android-mdc#manifest-customization
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Local key resource is written by scripts/configure_google_maps.py. -->
        <meta-data android:name="com.google.android.geo.API_KEY"
                   android:value="@string/day_google_maps_api_key" />
    </application>
</manifest>
